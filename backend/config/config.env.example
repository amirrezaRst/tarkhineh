PORT=5000
MONGO_URI="mongodb://localhost:27017/tarkhineh"

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_hex_string
REFRESH_TOKEN_SECRET=replace_with_a_different_long_random_hex_string

FRONT_ADDRESS="http://localhost:3000/"

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000

# Redis backs rate limiting, cached reads, and logout/token revocation. It's
# opt-in — everything falls back gracefully (in-memory rate limiting, no
# caching, no revocation check) when this is false, so it's safe to leave off
# if you don't have Redis running locally.
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379

# No SMS provider is wired up (this is a portfolio project, not a real
# product). When true, the OTP code is returned directly in the
# /user/register response instead of only existing in Mongo/Redis, so a demo
# deployment is actually usable by a visitor. Leave off for anything that
# isn't a public demo.
DEMO_MODE=false

# Zarinpal merchant id (sandbox test id: eaa46b01-819e-42ef-8a67-ba2bb7f69a32)
ZARINPAL_MERCHANT_ID=replace_with_your_zarinpal_merchant_id
ZARINPAL_SANDBOX=true
